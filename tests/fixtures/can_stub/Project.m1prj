<?xml version="1.0"?>
<!-- Synthetic m1-eval CAN-stub fixture. No proprietary MoTeC content. -->
<!--                                                                    -->
<!-- A single 100 Hz function exercises deterministic virtual CanComms: -->
<!-- it initializes a bus, opens a receive handle, consumes a scenario   -->
<!-- frame, and reads a float and unsigned integer from the same buffer. -->
<MoTeCM1BuildSession>
 <Project Name="CanStub" TargetHardware="ecu120">
  <ComponentStream><List>
   <Component Classname="BuiltIn.GroupCompound" Name="Root.CanDemo"/>
   <Component Classname="BuiltIn.GroupCompound" Name="Root.Events"/>
   <Component Classname="BuiltIn.EventKernel" Name="Root.Events.On 100Hz"/>

   <Component Classname="BuiltIn.Channel" Name="Root.CanDemo.Bus Value"><Props Type="f32"/></Component>

   <Component Classname="BuiltIn.FuncUser" Filename="CanDemo.Read.m1scr" Name="Root.CanDemo.Read">
    <Props SelectedTrigger="Root.Events.On 100Hz"/>
   </Component>
  </List></ComponentStream>
 </Project>
</MoTeCM1BuildSession>
